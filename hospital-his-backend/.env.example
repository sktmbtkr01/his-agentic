# ══════════════════════════════════════════════════════════════════════════════
# HOSPITAL HIS BACKEND - ENVIRONMENT CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values

# ─────────────────────────────────────────────────────────────────────────────
# SERVER CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5001

# For production (HF Spaces):
# PORT=7860
# NODE_ENV=production

# ─────────────────────────────────────────────────────────────────────────────
# MONGODB CONFIGURATION (Primary Database)
# ─────────────────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/hospital_his?retryWrites=true&w=majority

# ─────────────────────────────────────────────────────────────────────────────
# REDIS CONFIGURATION (Caching & Sessions)
# ─────────────────────────────────────────────────────────────────────────────
# Set USE_REDIS_CACHE=true to enable Redis
USE_REDIS_CACHE=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# For Redis Cloud / AWS ElastiCache:
# REDIS_HOST=redis-xxxxx.cloud.redislabs.com
# REDIS_PORT=12345
# REDIS_PASSWORD=your_redis_password
# REDIS_TLS=true

# ─────────────────────────────────────────────────────────────────────────────
# POSTGRESQL CONFIGURATION (Billing & Inventory)
# ─────────────────────────────────────────────────────────────────────────────
# Set USE_POSTGRES_BILLING=true and/or USE_POSTGRES_INVENTORY=true to enable
USE_POSTGRES_BILLING=false
USE_POSTGRES_INVENTORY=false
DUAL_WRITE_MODE=true

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lifeline_his
POSTGRES_USER=lifeline
POSTGRES_PASSWORD=your_secure_password
POSTGRES_SSL=false

# For production / cloud PostgreSQL:
# POSTGRES_HOST=your-instance.region.rds.amazonaws.com
# POSTGRES_SSL=true

# ─────────────────────────────────────────────────────────────────────────────
# JWT AUTHENTICATION
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=1h
JWT_REFRESH_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# ─────────────────────────────────────────────────────────────────────────────
# CORS CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# ─────────────────────────────────────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL CONFIGURATION (SMTP)
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@hospital.com
FROM_NAME=Hospital HIS

# ─────────────────────────────────────────────────────────────────────────────
# OPENROUTER LLM CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your_key_here
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# OpenRouter Agentic Inventory Agent
OPENROUTER_AGENTIC_INVENTORY_API_KEY=sk-or-v1-your_key_here
OPENROUTER_AGENTIC_INVENTORY_MODEL=nvidia/nemotron-3-nano-30b-a3b:free

# OpenRouter Agentic Insurance Pre-Auth Agent
OPENROUTER_AGENTIC_INSURANCE_API=sk-or-v1-your_key_here
OPENROUTER_AGENTIC_INSURANCE_MODEL=nvidia/nemotron-3-nano-30b-a3b:free

# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE API
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# EXTERNAL MICROSERVICES URLS (for HF Spaces deployment)
# ─────────────────────────────────────────────────────────────────────────────
OCR_SERVICE_URL=https://username-his-id-ocr.hf.space
VOICE_SERVICE_URL=https://username-his-voice-agent.hf.space
ML_REVENUE_SERVICE_URL=https://username-his-ml-services.hf.space
ML_PREDICT_SERVICE_URL=https://username-his-ml-services.hf.space

# ─────────────────────────────────────────────────────────────────────────────
# WELLNESS AGENT V2 - Agentic Nudge System
# ─────────────────────────────────────────────────────────────────────────────
WELLNESS_AGENT_NUDGE_V2=true
MIN_HOURS_BETWEEN_NUDGES=0
MAX_NUDGES_PER_DAY=10
NUDGE_EXPLORATION_RATE=0.1
ML_NUDGE_SERVICE_URL=http://localhost:8000

# ─────────────────────────────────────────────────────────────────────────────
# DEVICE SYNC - Wearable Integration
# ─────────────────────────────────────────────────────────────────────────────
PATIENT_PORTAL_URL=http://localhost:5174

# Fitbit
FITBIT_CLIENT_ID=your_fitbit_client_id
FITBIT_CLIENT_SECRET=your_fitbit_client_secret

# Google Fit
GOOGLE_FIT_CLIENT_ID=your_google_client_id
GOOGLE_FIT_CLIENT_SECRET=your_google_client_secret

# ─────────────────────────────────────────────────────────────────────────────
# AWS S3 CONFIGURATION (File Storage)
# ─────────────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=hospital-his-uploads

# ─────────────────────────────────────────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=logs
